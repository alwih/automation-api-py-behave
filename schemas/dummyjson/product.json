{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DummyJSON product",
  "description": "Extra keys are allowed: DummyJSON is still evolving, but the keys below must keep their types.",
  "type": "object",
  "required": [
    "id", "title", "description", "category", "price", "discountPercentage", "rating", "stock",
    "tags", "sku", "weight", "dimensions", "warrantyInformation", "shippingInformation",
    "availabilityStatus", "reviews", "returnPolicy", "minimumOrderQuantity", "meta", "images", "thumbnail"
  ],
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "price": {"type": "number", "exclusiveMinimum": 0},
    "discountPercentage": {"type": "number", "minimum": 0, "maximum": 100},
    "rating": {"type": "number", "minimum": 0, "maximum": 5},
    "stock": {"type": "integer", "minimum": 0},
    "tags": {"type": "array", "items": {"type": "string"}},
    "brand": {"type": "string", "description": "Not every product has a brand"},
    "sku": {"type": "string", "minLength": 1},
    "weight": {"type": "number", "minimum": 0},
    "dimensions": {
      "type": "object",
      "required": ["width", "height", "depth"],
      "properties": {
        "width": {"type": "number", "minimum": 0},
        "height": {"type": "number", "minimum": 0},
        "depth": {"type": "number", "minimum": 0}
      }
    },
    "warrantyInformation": {"type": "string"},
    "shippingInformation": {"type": "string"},
    "availabilityStatus": {"enum": ["In Stock", "Low Stock", "Out of Stock"]},
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rating", "comment", "date", "reviewerName", "reviewerEmail"],
        "properties": {
          "rating": {"type": "integer", "minimum": 1, "maximum": 5},
          "comment": {"type": "string"},
          "date": {"type": "string", "format": "date-time"},
          "reviewerName": {"type": "string"},
          "reviewerEmail": {"type": "string", "format": "email"}
        }
      }
    },
    "returnPolicy": {"type": "string"},
    "minimumOrderQuantity": {"type": "integer", "minimum": 1},
    "meta": {
      "type": "object",
      "required": ["createdAt", "updatedAt", "barcode", "qrCode"],
      "properties": {
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "barcode": {"type": "string"},
        "qrCode": {"type": "string", "format": "uri"}
      }
    },
    "images": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
    "thumbnail": {"type": "string", "format": "uri"}
  }
}
