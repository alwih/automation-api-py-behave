# Copy to .env and adjust. Environment variables and `behave -D NAME=value` override this file.

JSONPLACEHOLDER_BASE_URL=https://jsonplaceholder.typicode.com
DUMMYJSON_BASE_URL=https://dummyjson.com

# Seconds to wait for each request before failing
REQUEST_TIMEOUT=10

# Public demo account from https://dummyjson.com/docs/auth
DUMMYJSON_USERNAME=emilys
DUMMYJSON_PASSWORD=emilyspass
